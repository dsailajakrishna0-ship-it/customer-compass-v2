# Copy this file to .env (repo root) and fill in the values you need.
# .env is gitignored — never commit real secrets.
#
# Docker Compose reads this file automatically for variable substitution in
# docker-compose.yml (e.g. ${GOOGLE_API_KEY:-}) — it's separate from the
# per-service apps/api/.env and apps/api-py/.env files.

# --- Ollama model cache reuse (see scripts/setup-ollama-cache.sh) ----------
# OLLAMA_VOLUME_NAME=

# --- Google AI Studio key for embeddings (PR 3: ingestion pipeline) --------
# Get a free key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# --- LLM provider for chat/RAG/CRM routes (PR 4) ---------------------------
# LLM_PROVIDER=ollama          # "ollama" (default, local/free) or "cloud" (OpenRouter)
# OLLAMA_MODEL=qwen2.5:3b
# OPENROUTER_API_KEY=          # required only when LLM_PROVIDER=cloud or a request asks for provider: "cloud"
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# --- Stage 8.c/8.d guardrails ------------------------------------------------
# GUARD_MODE=rules             # rules (default) | llm (classifier only) | both
# GUARD_PROVIDER=ollama        # model that classifies prompts when GUARD_MODE is llm/both
# GUARD_MODEL=                 # optional OpenRouter model id when GUARD_PROVIDER=cloud
# SECURITY_AUDIT_RETENTION_DAYS=90
