# Copy this file to .env (repo root) and fill in the values you need.
# .env is gitignored — never commit real secrets.
#
# Docker Compose reads this file automatically for variable substitution in
# docker-compose.yml (e.g. ${GOOGLE_API_KEY:-}) — it's separate from the
# per-service apps/api/.env and apps/api-py/.env files.

# --- Ollama model cache reuse (see scripts/setup-ollama-cache.sh) ----------
# OLLAMA_VOLUME_NAME=

# --- Google AI Studio key for embeddings (PR 3: ingestion pipeline) --------
# Get a free key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
